# A least-privileged connection string, for the API server only.
EFATA_READ_DATABASE_URL=
# Full application runtime connection. Keep this server-only and separate from
# the health-check role above.
EFATA_DATABASE_URL=
# Supabase Postgres CA certificate (PEM), if required by the connection.
EFATA_DB_CA_PEM=
# Public production API origin. This is safe to place in client build settings;
# credentials and database URLs must remain server-only.
EFATA_API_ORIGIN=https://api.efata.io
# Exact comma-separated browser origins allowed to call authenticated endpoints.
# Native app requests do not send an Origin header.
EFATA_ALLOWED_ORIGINS=https://admin.efata.io
# Local server port.
PORT=3000
# Explicit opt-in for the read-only migration preview.
EFATA_ORDER_PREVIEW=0
EFATA_PREVIEW_DATABASE_URL=
EFATA_PREVIEW_SNAPSHOT_ID=
EFATA_FIREBASE_LOOKUP_API_KEY=
# Comma-separated exact browser origins and separately verified Firebase admin UIDs.
EFATA_PREVIEW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
EFATA_PREVIEW_ADMIN_UIDS=
